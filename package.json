{
    "name": "sfddj",
    "version": "1.2.2",
    "description": "Official JavaScript client for the SFD-DJ.EU API: room bots, browser extensions and tools. Rooms, chat, playlists, characters and plans. No dependencies.",
    "keywords": [
        "sfd-dj.eu",
        "sfddj",
        "bot",
        "api",
        "music",
        "plug.dj",
        "room bot",
        "extension",
        "playlist"
    ],
    "license": "MIT",
    "homepage": "https://sfd-dj.eu/developers",
    "discord": "https://discord.gg/p4FD5VHgbN",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p .",
        "test": "npm run build && node --test test/",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
